APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Development placeholder only. Production must use a random secret of at least 32 characters.
SECRET_KEY=change-me
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chainreaction
# Example Neon connection (quote it and URL-encode reserved password characters)
# DATABASE_URL="postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@HOST/DATABASE?ssl=require"
REDIS_URL=redis://localhost:6379/0
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=account;AccountKey=key==;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=replays
# Public origin serving /orb-skins/{asset_key}/{preview.webp,texture.webp,detail.webp,collision.mp3}
ORB_SKIN_ASSET_BASE_URL=https://chain-reaction-frontend-ebon.vercel.app
GAME_BOARD_WIDTH=8
GAME_BOARD_HEIGHT=8
MINI_BOARD_WIDTH=5
MINI_BOARD_HEIGHT=5
GAME_CLOCK_SECONDS=300
MINI_GAME_CLOCK_SECONDS=600
WEBSOCKET_HEARTBEAT_SECONDS=15
WEBSOCKET_MESSAGES_PER_MINUTE=120
WEBSOCKET_SNAPSHOTS_PER_MINUTE=20
WEBSOCKET_CONNECTIONS_PER_MINUTE=30
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
RATE_LIMIT_MOVES_PER_MINUTE=60
MATCHMAKING_QUEUE_LEASE_SECONDS=180
MATCHMAKING_QUEUE_TIMEOUT_SECONDS=30
